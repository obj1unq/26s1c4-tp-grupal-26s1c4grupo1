import wollok.game.*
import extras.* 

program guitarHero {
        game.width(10)
        game.height(10)
        game.title("Guitar Hero")
        const nota1 = new NotaMusical(position = game.at(5, 10))
        game.addVisual(nota1)
        game.onTick(1000, "movimiento de nota", {nota1.caer()})
        game.start()
}
